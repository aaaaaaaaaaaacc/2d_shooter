[gd_resource type="ShaderMaterial" load_steps=2 format=2]

[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;

// Distortion strength
uniform float shake_power = 0.03;

// Chance of distortion
uniform float shake_rate : hint_range(0.0, 1.0) = 0.2;

// Distortion speed
uniform float shake_speed = 5.0;

// Number/size of horizontal glitch blocks
uniform float shake_block_size = 30.5;

// RGB separation
uniform float shake_color_rate : hint_range(0.0, 1.0) = 0.01;


float random(float seed)
{
	return fract(
		543.2543 *
		sin(
			dot(
				vec2(seed, seed),
				vec2(3525.46, -54.3415)
			)
		)
	);
}


void fragment()
{
	// Decide whether this frame is being distorted
	float enable_shift = float(
		random(trunc(TIME * shake_speed))
		< shake_rate
	);

	// Start with the sprite's local UV coordinates.
	vec2 fixed_uv = UV;

	// Create horizontal glitch blocks.
	float block = trunc(UV.y * shake_block_size) / shake_block_size;

	// Give each horizontal block a random horizontal offset.
	float shift = (
		random(block + TIME) - 0.5
	) * shake_power * enable_shift;

	fixed_uv.x += shift;

	// Sample the original sprite
	vec4 pixel_color = texture(TEXTURE, fixed_uv);

	// Red channel shifted to the right
	float red = texture(
		TEXTURE,
		fixed_uv + vec2(shake_color_rate, 0.0)
	).r;

	// Blue channel shifted to the left
	float blue = texture(
		TEXTURE,
		fixed_uv - vec2(shake_color_rate, 0.0)
	).b;

	// Exactly the same basic RGB separation idea as the original.
	pixel_color.r = mix(
		pixel_color.r,
		red,
		enable_shift
	);

	pixel_color.b = mix(
		pixel_color.b,
		blue,
		enable_shift
	);

	COLOR = pixel_color;
}"

[resource]
shader = SubResource( 1 )
shader_param/shake_power = 0.2
shader_param/shake_rate = 0.3
shader_param/shake_speed = 5.0
shader_param/shake_block_size = 30.0
shader_param/shake_color_rate = 0.1
